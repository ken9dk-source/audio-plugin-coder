  "trance_signature_rules": {
    "uplifting_trance_lead": {
      "voiceMode": "Poly",
      "osc1_wave": [
        "Saw",
        "MultiSaw",
        "Pulse"
      ],
      "cutoff": ">=180 (bright)",
      "resonance": "low-mid (40-120)",
